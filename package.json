{
  "name": "translucid-investigation-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "investigate": "node --env-file-if-exists=.env --import tsx src/headless/cli.ts",
    "finalize": "node --env-file-if-exists=.env --import tsx src/headless/finalize-cli.ts",
    "attach": "node --env-file-if-exists=.env --import tsx scripts/attach-headless.ts",
    "runtime:manifest": "node --env-file-if-exists=.env --import tsx scripts/runtime-manifest.ts",
    "e2b:build-template": "node --env-file-if-exists=.env --import tsx scripts/build-e2b-template.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.18",
    "@opencode-ai/sdk": "1.18.18",
    "e2b": "2.38.2",
    "opencode-ai": "1.18.18",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.19.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pdfkit": "0.17.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3"
  }
}
