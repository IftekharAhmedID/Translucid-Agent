{
  "name": "translucid-investigation-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "runner": "node --env-file-if-exists=.env --import tsx src/runner/index.ts",
    "gateway": "node --env-file-if-exists=.env --import tsx src/gateway/server.ts",
    "attach": "node --env-file-if-exists=.env --import tsx scripts/attach-local.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "runtime:manifest": "node --env-file-if-exists=.env --import tsx scripts/runtime-manifest.ts",
    "e2b:build-template": "node --env-file-if-exists=.env --import tsx scripts/build-e2b-template.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration": "tsx --test --test-concurrency=1 \"src/**/*.integration.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "@opencode-ai/sdk": "1.18.15",
    "drizzle-orm": "0.45.2",
    "e2b": "2.38.2",
    "next": "16.3.0",
    "opencode-ai": "1.18.15",
    "pdfjs-dist": "6.2.108",
    "pdfkit": "0.19.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tsx": "4.23.11",
    "typescript": "6.0.3"
  }
}
