{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "enabled_providers": ["translucid"],
  "model": "translucid/deepseek-v4-flash",
  "small_model": "translucid/deepseek-v4-flash",
  "subagent_depth": 1,
  "compaction": { "auto": true, "prune": true },
  "plugin": ["file:///opt/investigator/runtime/headless-opencode/plugin/translucid.ts"],
  "instructions": ["/workspace/case/INSTRUCTIONS.md"],
  "provider": {
    "translucid": {
      "name": "Translucid headless run gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "{env:CASE_GATEWAY_URL}/internal/llm/v1", "apiKey": "{env:CASE_TOKEN}", "timeout": 300000 },
      "models": {
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "reasoning": true, "tool_call": true, "limit": { "context": 200000, "output": 32000 } },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "reasoning": true, "tool_call": true, "limit": { "context": 200000, "output": 32000 } },
        "mimo-v2.5-pro": { "name": "MiMo V2.5 Pro", "attachment": true, "reasoning": true, "tool_call": true, "modalities": { "input": ["text", "image"], "output": ["text"] }, "limit": { "context": 200000, "output": 32000 } },
        "mimo-v2.5-free": { "name": "MiMo V2.5 Free", "attachment": true, "reasoning": true, "tool_call": true, "modalities": { "input": ["text", "image"], "output": ["text"] }, "limit": { "context": 200000, "output": 32000 } }
      }
    }
  },
  "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny", "external_directory": "deny", "doom_loop": "deny" },
  "tools": { "bash": false, "edit": false, "write": false, "webfetch": false, "websearch": false },
  "experimental": { "chatMaxRetries": 2, "disable_paste_summary": true }
}
