{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "enabled_providers": ["translucid"],
  "model": "translucid/deepseek-v4-pro",
  "small_model": "translucid/deepseek-v4-pro",
  "subagent_depth": 0,
  "compaction": { "auto": true, "prune": true },
  "plugin": ["file:///opt/investigator/runtime/headless-opencode/plugin/translucid.ts"],
  "instructions": ["/workspace/case/INSTRUCTIONS.md"],
  "provider": {
    "translucid": {
      "name": "Translucid headless run gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "{env:CASE_GATEWAY_URL}/internal/llm/v1", "apiKey": "{env:CASE_TOKEN}", "timeout": 720000 },
      "models": {
        "gpt-5.6-luna": { "name": "GPT 5.6 Luna", "provider": { "npm": "@ai-sdk/openai" }, "reasoning": true, "tool_call": true, "variants": { "xhigh": { "reasoningEffort": "xhigh" } }, "limit": { "context": 200000, "output": 32000 } },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "provider": { "npm": "@ai-sdk/openai-compatible" }, "reasoning": true, "tool_call": true, "variants": { "xhigh": { "reasoningEffort": "max" } }, "limit": { "context": 1000000, "output": 384000 } }
      }
    }
  },
  "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny", "external_directory": "deny", "doom_loop": "deny" },
  "tools": { "bash": false, "edit": false, "write": false, "webfetch": false, "websearch": false },
  "experimental": { "chatMaxRetries": 2, "disable_paste_summary": true }
}
