FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git poppler-utils ripgrep && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/coordinator
COPY package.json package-lock.json ./
RUN npm ci
COPY Dockerfile ./
COPY scripts scripts
COPY src src
COPY runtime runtime
COPY landing/public/email-domains.json landing/public/email-domains.json
RUN mkdir -p /workspace/job && chown -R node:node /workspace
USER node
EXPOSE 8787
