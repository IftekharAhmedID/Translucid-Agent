FROM node:22-bookworm-slim AS frontend
WORKDIR /frontend
COPY landing/package.json landing/package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY landing ./
RUN npm run build

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git poppler-utils && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY src src
COPY scripts scripts
COPY runtime runtime
COPY Dockerfile ./
COPY landing/public/email-domains.json landing/public/email-domains.json
COPY --from=frontend /frontend/dist landing/dist
RUN mkdir -p /var/data/tracedog && chown -R node:node /var/data/tracedog
USER node
ENV PORT=10000
EXPOSE 10000
CMD ["node", "--import", "tsx", "src/web/server.ts"]
